# Autotask API credentials
# Get these from Autotask Admin > Resources > API User
AUTOTASK_API_USER=api.user@yourdomain.com
AUTOTASK_API_SECRET=your-api-secret-here
AUTOTASK_API_INTEGRATION_CODE=your-integration-code
AUTOTASK_API_ZONE=https://webservices6.autotask.net

# AI-Powered Analysis (optional)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Server config
PORT=3000

# PA Cyber Watch Feed
# Teams webhook for incident alerts (create via Teams > Connectors > Incoming Webhook)
TEAMS_WEBHOOK_URL=
# Auto-start feed polling on server launch (true/false)
PA_FEED_AUTO_START=false
# Enable social source monitoring (true/false)
PA_FEED_ENABLE_SOCIAL=false
# Minimum confidence score to send Teams alerts (default: 50)
PA_FEED_MIN_ALERT_CONFIDENCE=50
# Dashboard URL for alert card links
DASHBOARD_URL=
